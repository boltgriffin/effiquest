# Copy to `.env.local` for local overrides. Never commit real values (.env* files are git-ignored,
# except this example). Only variables prefixed with VITE_ are exposed to the browser bundle:
# never put a secret in one.

# development | production (informational; Vite's own MODE is the source of truth for builds)
VITE_APP_ENV=development

# Optional cloud backend (Milestone 11, docs/BACKEND_AND_SECURITY.md). Leave both empty to run
# device-only: every feature except "Online class" works without them.
# URL: Supabase dashboard > Project Settings > API > Project URL (or http://127.0.0.1:54321 for
# a local `supabase start`).
# KEY: the ANON / publishable key only. It is public by design; Row Level Security protects data.
# The app refuses to start the backend if a service-role / secret key is put here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NEVER add SUPABASE_SERVICE_ROLE_KEY (or any sb_secret_ key) to this app or any VITE_ variable.
# Administrative tasks (granting the teacher role, backups) use the Supabase dashboard or CLI.
