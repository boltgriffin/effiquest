# Copy to `.env.local` for local overrides. Never commit real values.
# Only variables prefixed with VITE_ are exposed to the browser bundle - never put secrets here.

# development | production (informational; Vite's own MODE is the source of truth for builds)
VITE_APP_ENV=development

# Reserved for a future cloud backend. NOT used in Milestone 02 (Supabase is not approved yet, decision D-03).
# The anon key is public by design; a service-role key must NEVER appear in any VITE_ variable.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
